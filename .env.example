# ============================================================
#  JARVIS  ·  environment configuration
#  Copy this file to ".env" and fill in your keys.
#  (cp .env.example .env    /    copy .env.example .env)
# ============================================================

# --- Fish Audio (the voice) --------------------------------
# Get a key at https://fish.audio  ->  App  ->  API Keys
FISH_API_KEY=

# The JARVIS voice model from the Fish Audio Voice Library.
# Default is the popular "Jarvis (MCU)" model (118k+ uses).
# Swap for any reference_id from https://fish.audio/voice-library
FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# Fish model + latency profile. s2.1-pro is the fastest/best.
# latency: low | normal | balanced   (low = snappiest)
FISH_MODEL=s2.1-pro
FISH_LATENCY=balanced

# --- The brain (Claude) ------------------------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model. Default is Haiku 4.5 for the LOWEST response time (voice needs to feel
# instant). Bump to claude-sonnet-5 for wittier replies, claude-opus-5 for the
# smartest. Latency grows in that order.
JARVIS_MODEL=claude-haiku-4-5

# --- Email (send-an-email action) --------------------------
# Uses Gmail SMTP. Create an App Password (NOT your normal password):
#   Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Where JARVIS sends by default when you don't name a recipient.
# Leave blank to default to EMAIL_ADDRESS (yourself).
EMAIL_DEFAULT_TO=

# --- Spotify (play-music action) ---------------------------
# Requires Spotify Premium + a free app at
# https://developer.spotify.com/dashboard
# Add this exact Redirect URI in the dashboard: http://127.0.0.1:8888/callback
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Your Fish Audio collab / UTM link ---------------------
# This is the link promoted in the app + README for the collaboration.
# REPLACE with your real UTM tracking link before sharing.
FISH_AUDIO_UTM=https://fish.audio/?fpr=rcic6s
